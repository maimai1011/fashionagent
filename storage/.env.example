# Shared application ports
DOCKER_BIND_HOST=127.0.0.1
API_HOST=127.0.0.1
API_PORT=8002
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501
UI_HOST=127.0.0.1
UI_PORT=7860
VLLM_HOST=127.0.0.1
VLLM_PORT=8003
VLLM_MODEL=fashion-llm
VLLM_API_KEY=EMPTY
UPLOAD_MAX_BYTES=10485760

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_INTERNAL_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# MinIO
MINIO_SCHEME=http
MINIO_HOST=localhost
MINIO_PORT=9090
MINIO_INTERNAL_PORT=9000
MINIO_CONSOLE_PORT=9091
MINIO_CONSOLE_INTERNAL_PORT=9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=fashion-products

# Milvus and etcd
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_INTERNAL_PORT=19530
MILVUS_METRICS_PORT=9092
MILVUS_METRICS_INTERNAL_PORT=9091
ETCD_INTERNAL_PORT=2379
MILVUS_COLLECTION=image_features
MILVUS_EMBEDDING_DIM=512
WARDROBE_MIN_SIMILARITY=0.20
REMBG_MODEL=u2net

# RabbitMQ and Celery
CELERY_RESULT_BACKEND=rpc://
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_INTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_INTERNAL_PORT=15672

# MLflow
MLFLOW_PORT=5001
MLFLOW_INTERNAL_PORT=5000

# Optional LangSmith tracing for chat model and tool runs.
# Add your own API key, then set LANGSMITH_TRACING=true.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=fashion-chat
# LANGSMITH_API_KEY=

# Optional local logs with user messages, tool arguments, and stylist output.
# Enable only while debugging; local logs may then contain personal data.
AGENT_LOG_CONTENT=false

# Optional local traces and metrics. Run the observability Compose profile first.
# Use the host endpoint for the API and the Docker service endpoint for the worker.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# WORKER_OTEL_ENDPOINT=http://otel-collector:4318
OTEL_COLLECTOR_PORT=4318
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9093
GRAFANA_PORT=3000
