POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=image_features
MILVUS_EMBEDDING_DIM=512

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET=images

# vLLM (OpenAI-compatible endpoint)
VLLM_URL=http://localhost:8002/v1
VLLM_MODEL=fashion-llm
VLLM_API_KEY=EMPTY
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
AGENT_RECURSION_LIMIT=20
REQUEST_TIMEOUT_SECONDS=180

# Existing Milvus product catalog (never created by the application)
MILVUS_URI=http://localhost:19530
MILVUS_PRODUCT_COLLECTION=products
MILVUS_METRIC_TYPE=COSINE
MILVUS_SEARCH_TIMEOUT_SECONDS=8
MILVUS_MAX_CONCURRENCY=4
MILVUS_FIELD_PRODUCT_ID=product_id
MILVUS_FIELD_VECTOR=embedding
MILVUS_FIELD_NAME=name
MILVUS_FIELD_DESCRIPTION=description
MILVUS_FIELD_CATEGORY=category
MILVUS_FIELD_COLOR=color
MILVUS_FIELD_MATERIAL=material
MILVUS_FIELD_FIT=fit
MILVUS_FIELD_PRICE=price
MILVUS_FIELD_STOCK=stock
MILVUS_FIELD_IMAGE_URL=image_url

# Must exactly match product-indexing configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=
EMBEDDING_MAX_CONCURRENCY=2

# Checkpoints: memory for local use, postgres for production
CHECKPOINT_BACKEND=memory
CHECKPOINT_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/app
LANGGRAPH_STRICT_MSGPACK=true

# API and UI
API_HOST=127.0.0.1
API_PORT=8080
API_BASE_URL=http://127.0.0.1:8080
API_RATE_LIMIT_PER_MINUTE=30
APP_API_KEY=change-me
# Production option: JSON map of authenticated user IDs to bearer tokens.
APP_USER_TOKENS_JSON=
VALIDATE_MILVUS_ON_STARTUP=true
UI_HOST=127.0.0.1
UI_PORT=7860
UI_AUTH_USER=admin
UI_AUTH_PASSWORD=change-me
UI_USER_TOKEN=change-me
ENABLE_NGROK=false
NGROK_AUTHTOKEN=
