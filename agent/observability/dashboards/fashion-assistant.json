{
  "uid": "fashion-assistant",
  "title": "Fashion Assistant",
  "tags": ["fashion", "observability"],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "fashion-prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum by (status_code) (rate(fashion_http_requests_total[5m]))",
        "legendFormat": "HTTP {{status_code}}"
      }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "fashion-prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(fashion_http_duration_seconds_bucket[5m])))",
        "legendFormat": "p95 seconds"
      }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Chat turns per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "fashion-prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum by (outcome) (rate(fashion_chat_turns_total[5m]))",
        "legendFormat": "{{outcome}}"
      }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Wardrobe tasks per second",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "fashion-prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum by (task, outcome) (rate(fashion_wardrobe_tasks_total[5m]))",
        "legendFormat": "{{task}} {{outcome}}"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Intent decisions per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "fashion-prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum by (outcome) (rate(fashion_intent_decisions_total[5m]))",
        "legendFormat": "{{outcome}}"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stylist calls per second",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "fashion-prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum by (outcome) (rate(fashion_stylist_calls_total[5m]))",
        "legendFormat": "{{outcome}}"
      }]
    }
  ]
}
